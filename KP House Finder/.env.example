# Anthropic API key for the extraction LLM
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project (Dashboard -> Project Settings -> API)
# Use the same URL + anon key the Chrome extension popup uses.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Prospecting feature (src/discover.py + src/enrich.py)
# Google Maps Platform key with Places API (New) enabled + billing on.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# SerpApi key for Google Hotels price enrichment (https://serpapi.com/manage-api-key).
SERPAPI_KEY=your-serpapi-key
